# Apartmani Elegance — availability calendar iCal feeds
# Set these in Vercel: Project → Settings → Environment Variables (Production).
# Each apartment has two feeds: its Booking.com calendar export and its Airbnb
# calendar export. The /api/availability function merges both. If one feed is
# missing the apartment simply shows only the other source's blocked dates.
#
# How to get each URL: see docs/availability-calendar.md

# Deluxe Apartman (80m²)
ICAL_DELUXE_BOOKING=https://ical.booking.com/v1/export?t=XXXXXXXX
ICAL_DELUXE_AIRBNB=https://www.airbnb.com/calendar/ical/XXXXXXXX.ics?s=XXXXXXXX

# Trosoban Apartman (41m²)
ICAL_TROSOBAN_BOOKING=https://ical.booking.com/v1/export?t=XXXXXXXX
ICAL_TROSOBAN_AIRBNB=https://www.airbnb.com/calendar/ical/XXXXXXXX.ics?s=XXXXXXXX

# Dvosoban Apartman (41m²)
ICAL_DVOSOBAN_BOOKING=https://ical.booking.com/v1/export?t=XXXXXXXX
ICAL_DVOSOBAN_AIRBNB=https://www.airbnb.com/calendar/ical/XXXXXXXX.ics?s=XXXXXXXX

# Dvosoban sa dnevnim boravkom (41m²)
ICAL_DVOSOBAN_DNEVNI_BOOKING=https://ical.booking.com/v1/export?t=XXXXXXXX
ICAL_DVOSOBAN_DNEVNI_AIRBNB=https://www.airbnb.com/calendar/ical/XXXXXXXX.ics?s=XXXXXXXX
